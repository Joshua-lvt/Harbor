# harbor-cloud — Cloudflare Worker (Durable Objects relay)
#
# Most ignore rules live in the repo-root .gitignore (node_modules, .wrangler,
# .dev.vars, dist, logs, etc.). This file keeps only Worker-specific notes.

# Cloudflare Wrangler local state (local DO SQLite, observability traces, tmp
# bundles) — regenerated by `wrangler dev`. Never commit (contains local DO data).
.wrangler/

# Worker local dev secrets — created via `wrangler secret put` or .dev.vars.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Vite/Node incidental
node_modules/
*.log
*.tsbuildinfo
