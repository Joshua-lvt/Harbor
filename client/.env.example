# Harbor client — build-time environment (template).
#
# Copy this file to `.env` and fill in your production values. The `.env` file is
# git-ignored (see repo-root .gitignore: `.env`, `.env.*` with `!.env.example`).
# Vite statically substitutes any `VITE_*` key at build time — see
# `client/src/lib/types.ts` (`DEFAULT_RELAY_URL`) and `client/src/vite-env.d.ts`.
#
# The production Cloudflare Worker relay URL. Required for `npm run tauri build`
# so the built app dials the deployed Worker instead of the local wrangler-dev
# default (ws://localhost:8787). Leave blank/absent for local development.
VITE_RELAY_URL=wss://harbor-cloud.YOUR-ACCOUNT.workers.dev
