# =============================================================================
# Harbor — root .gitignore
#
# Only files needed to rebuild Harbor are versioned. Anything local, generated,
# machine-specific, or containing real user data / credentials is excluded.
# =============================================================================

# ----------------------------------------------------------------------------
# Secrets & local data (NEVER commit these)
# ----------------------------------------------------------------------------
# Per-install device identity (device_id, device_secret, E2E keys, partner).
# Lives only in %AppData%\com.harbor.app — but block it everywhere just in case.
identity.json
identity.json.*
**/identity.json
**/identity.json.*

# Local SQLite databases + backups (personal message history, activity, icons).
*.db
*.db-shm
*.db-wal
*.db.bak
*.db.bak-*
harbor.db
harbor.db.*

# Generic backups / dumps
*.bak
*.bak-*

# Environment files (may carry build-time secrets like VITE_RELAY_URL prod URL)
.env
.env.*
!.env.example
!.env.template

# Worker local secrets (Cloudflare .dev.vars)
.dev.vars
.dev.vars.*

# Updater signing keypair (Fase 2 mandatory auto-update). Generated locally
# with `tauri signer generate`. The PRIVATE key (.tauri/harbor.key + its
# password) is NEVER committed — it lives only in GitHub Secrets
# (TAURI_SIGNING_PRIVATE_KEY / _PASSWORD) and signs the .exe in CI. The PUBLIC
# half is embedded in client/src-tauri/tauri.conf.json (plugins.updater.pubkey),
# which IS committed, so exclude the whole .tauri/ directory to avoid ever
# leaking the private half.
/.tauri/

# ----------------------------------------------------------------------------
# Test-only second client (com.harbor.appb) — local two-client smoke only.
# NOT shipped; never version the whole client-b tree.
# ----------------------------------------------------------------------------
/client-b/

# ----------------------------------------------------------------------------
# Local machine helpers / scratch
# ----------------------------------------------------------------------------
# Bootstrap scripts that hardcode this machine's absolute paths and/or rewrite
# strict-JSON configs to stale layouts (setup-client.ps1 would revert the
# Home redesign). Keep them local.
/testharbor.bat
/client/setup-client.ps1

# Vite temp jitter files (e.g. vite.config.ts.timestamp-*.mjs)
*.timestamp-*.mjs

# Claude Code local permission/allowlist (machine-specific paths)
/.claude/

# Personal dev plan docs (randomly-named planning scratch)
/partitioned-wibbling-wilkinson.md
/rosy-meandering-treehouse.md

# ----------------------------------------------------------------------------
# Backups directory (local data zips)
# ----------------------------------------------------------------------------
/backups/

# ----------------------------------------------------------------------------
# Dependencies (install via npm/cargo, never commit)
# ----------------------------------------------------------------------------
node_modules/
**/node_modules/

# Python virtualenv + caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/

# ----------------------------------------------------------------------------
# Build artifacts / generated output
# ----------------------------------------------------------------------------
# Vite frontend build output
dist/
**/dist/

# Local Linux packaging output and downloaded linuxdeploy tool.
linux/Harbor*.AppImage
linuxdeploy*.AppImage
/linuxdeploy-plugin-gtk/

# Rust / Tauri build output + generated Tauri schemas (regenerated by build)
target/
**/target/
**/src-tauri/target/
**/src-tauri/gen/

# Cloudflare Wrangler local state (local DO SQLite, observability, tmp bundles)
.wrangler/
**/.wrangler/

# Logs
*.log
**/*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / cache
coverage/
*.lcov
.cache/
.nyc_output/
*.tsbuildinfo

# ----------------------------------------------------------------------------
# Editors / OS
# ----------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
