# Harbor Server — Oracle staging/production environment (non-secret).
# Install: copy to /etc/harbor-server/harbor-server.env with mode 0600,
# fill the endpoint fields below, then
# `systemctl daemon-reload && systemctl enable --now harbor-server`.
# No keys, tokens, or DDNS URLs ever belong here (see oracle-migration.md).
#
# Production endpoint (raw Oracle IPv4, NO domain): the same value in both
# variables — clients dial it directly, the server advertises it in TURN.
# It lives ONLY here and in process environments, never compiled into the app.
HARBOR_SERVER_BIND=10.0.0.7:9091
HARBOR_SERVER_STATE_DIR=/var/lib/harbor-server
#HARBOR_TURN_EXTERNAL_IP=<oracle-ipv4>
#HARBOR_ORACLE_ADDRESS=<oracle-ipv4>:9091
# Per-allocation relay sockets (16 = MAX_TURN_ALLOCATIONS). Open this UDP
# range only at Gate 9, after the code + canary prove a consumer exists.
HARBOR_TURN_RELAY_PORT_RANGE=49160-49175
